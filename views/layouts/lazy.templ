package layouts

import "github.com/Francesco99975/authpoc/views/ui"

templ Lazy(indicatorID string, label string, route string) {
	<div class="relative">
		<div
			hx-get={ route }
			hx-trigger="intersect once delay:200ms"
			hx-swap="innerHTML"
			hx-indicator={ "#" + indicatorID }
		>
			{ children... }
		</div>
		@ui.FormLoading(indicatorID, label)
	</div>
}
