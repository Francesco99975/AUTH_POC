package layouts

templ DashSection(title string, sub string, tag string) {
	<section class="neon-border clip-panel p-4 sm:p-6 w-full min-w-0 overflow-hidden">
		<header class="flex items-center justify-between gap-2 mb-4 min-w-0">
			<div class="min-w-0">
				<div class="font-mono text-[10px] text-accent uppercase tracking-widest truncate">{ sub }</div>
				<h2 class="text-lg sm:text-xl font-bold neon-accent truncate">{ title }</h2>
			</div>
			<span class="clip-tag font-mono text-[10px] uppercase px-2 py-0.5 border border-info text-info flex-none whitespace-nowrap">{ tag }</span>
		</header>
		{ children... }
	</section>
}
