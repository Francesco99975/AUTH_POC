package layouts

import (
	"fmt"
	"github.com/Francesco99975/authpoc/views/ui"
	"time"
)

templ Poller(indicatorID string, label string, route string, interval time.Duration) {
	<div class="relative">
		<div
			hx-get={ route }
			hx-trigger={ "intersect once, every " + fmt.Sprintf("%ds", int(interval.Seconds())) }
			hx-swap="innerHTML"
			hx-indicator={ "#" + indicatorID }
		>
			{ children... }
		</div>
		@ui.FormLoading(indicatorID, label)
	</div>
}
