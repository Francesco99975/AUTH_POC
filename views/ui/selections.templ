package ui

// CheckboxProps — single boolean field rendered as the CP cross-mark.
type CheckboxProps struct {
	Name     string
	Value    string // form-submitted value when checked (defaults to "on")
	Label    string
	Checked  bool
	Disabled bool
	Attrs    templ.Attributes
}

// Checkbox — labelled boolean. Clicking the label toggles via native <label> binding.
templ Checkbox(p CheckboxProps) {
	<label class="flex items-center gap-2 cursor-pointer py-1">
		<input
			type="checkbox"
			class="cp-check"
			name={ p.Name }
			value={ nonEmpty(p.Value, "on") }
			checked?={ p.Checked }
			disabled?={ p.Disabled }
			{ p.Attrs... }
		/>
		if p.Label != "" {
			<span class="text-sm">{ p.Label }</span>
		}
		{ children... }
	</label>
}

// RadioOption is one choice inside a @RadioGroup.
type RadioOption struct {
	Value string
	Label string
}

// RadioGroup renders a labelled vertical radio list. Selection is controlled by `initial`.
templ RadioGroup(name, initial, label string, opts ...RadioOption) {
	<fieldset>
		if label != "" {
			<legend class="font-mono text-[11px] text-accent uppercase tracking-widest mb-2">{ label }</legend>
		}
		<div class="flex flex-col gap-1">
			for _, o := range opts {
				<label class="flex items-center gap-2 cursor-pointer py-0.5">
					<input
						type="radio"
						name={ name }
						value={ o.Value }
						checked?={ o.Value == initial }
						class="cp-radio"
					/>
					<span class="text-sm">{ o.Label }</span>
				</label>
			}
		</div>
	</fieldset>
}

// SwitchProps — on/off toggle, styled as a neon slider.
type SwitchProps struct {
	Name     string
	Label    string // text to the LEFT of the switch
	Checked  bool
	Disabled bool
	// When set, toggling fires hx-post to this URL with the new state.
	PostURL string
	Attrs   templ.Attributes
}

// Switch — labelled on/off control. Pair with PostURL for one-liner settings toggles.
templ Switch(p SwitchProps) {
	<label class="flex items-center justify-between py-1 gap-3">
		if p.Label != "" {
			<span class="text-sm">{ p.Label }</span>
		}
		if p.PostURL != "" {
			<input
				type="checkbox"
				class="cp-switch"
				name={ p.Name }
				checked?={ p.Checked }
				disabled?={ p.Disabled }
				hx-post={ p.PostURL }
				hx-swap="none"
				{ p.Attrs... }
			/>
		} else {
			<input
				type="checkbox"
				class="cp-switch"
				name={ p.Name }
				checked?={ p.Checked }
				disabled?={ p.Disabled }
				{ p.Attrs... }
			/>
		}
	</label>
}

// DropOption is one entry in @Droplist / @Combobox.
type DropOption struct {
	Value string
	Label string
}

// DroplistProps — single-select dropdown.
//
// `required` is a struct field because it's a static schema decision (a
// field either is or isn't required at the form definition). `disabled`
// and `value` are runtime state and flow through Attrs.
// DroplistProps — single-select custom dropdown.
//
// `required` is a struct field because it's a static schema decision (a
// field either is or isn't required at the form definition). `disabled`
// and `value` are runtime state and flow through Attrs onto the underlying
// hidden form-bearing <input>.
type DroplistProps struct {
	Name        string
	Label       string
	Selected    string
	Required    bool
	Placeholder string // shown when nothing is selected (defaults to "Select…")
	Opts        []DropOption
	Attrs       templ.Attributes
}

// Droplist is a fully-custom single-select dropdown built on the W3C ARIA 1.2
// "combobox + listbox" pattern — fully styleable, while remaining semantically
// correct for screen readers:
//
//   • Trigger is a <button role="combobox"> with aria-haspopup="listbox",
//     aria-expanded, and aria-controls pointing at the popup.
//   • Popup is a real <ul role="listbox"> of <li role="option"> nodes — so
//     AT announces it as "listbox, N options".
//   • aria-activedescendant tracks the keyboard-focused option without
//     moving DOM focus off the trigger.
//   • Full keyboard support: ↑/↓ to move, Home/End to jump, Enter/Space
//     to pick, Esc to close, single-letter type-ahead jumps to next match.
//   • A hidden form-bearing <input name=...> carries the selected value so
//     the component integrates with normal form submission and accepts
//     dynamic `disabled`/`value` attributes via Attrs.
templ Droplist(p DroplistProps) {
	{{placeholder := p.Placeholder
if placeholder == "" {
	placeholder = "Select…"
}
	}}
	{{listID := p.Name + "-listbox"
btnID := p.Name + "-trigger"
	}}
	<div
		x-data={ "{ open:false, sel: '" + p.Selected + "', active: -1, " +
				"opts: " + dropOptsToJS(p.Opts) + ", " +
				"labelOf(v){ const o = this.opts.find(x => x.v === v); return o ? o.l : ''; }, " +
				"toggle(){ this.open = !this.open; if(this.open){ this.active = Math.max(0, this.opts.findIndex(o => o.v === this.sel)); this.$nextTick(()=>this.scrollActive()); } }, " +
				"pick(i){ if(i<0||i>=this.opts.length) return; this.sel = this.opts[i].v; this.open = false; this.$refs.trigger.focus(); }, " +
				"move(d){ if(!this.open){ this.open = true; this.active = Math.max(0, this.active); } " +
				"else { this.active = (this.active + d + this.opts.length) % this.opts.length; } this.$nextTick(()=>this.scrollActive()); }, " +
				"jump(i){ this.open = true; this.active = i; this.$nextTick(()=>this.scrollActive()); }, " +
				"typeahead(k){ if(!/^[a-z0-9]$/i.test(k)) return; const start = (this.active + 1) % this.opts.length; " +
				"for(let n=0; n<this.opts.length; n++){ const i = (start + n) % this.opts.length; " +
				"if(this.opts[i].l.toLowerCase().startsWith(k.toLowerCase())){ this.jump(i); return; } } }, " +
				"scrollActive(){ const el = this.$refs['opt-'+this.active]; if(el && el.scrollIntoView) el.scrollIntoView({block:'nearest'}); } }" }
		@keydown.escape.window="if(open){ open = false; $refs.trigger.focus(); }"
		@click.away="open = false"
		class="relative h-fit self-start"
	>
		if p.Label != "" {
			<label for={ btnID } class="block font-mono text-[10px] text-accent uppercase tracking-widest mb-1">{ p.Label }</label>
		}
		<button
			id={ btnID }
			x-ref="trigger"
			type="button"
			role="combobox"
			aria-haspopup="listbox"
			aria-controls={ listID }
			:aria-expanded="open.toString()"
			:aria-activedescendant={ "open && active >= 0 ? '" + listID + "-opt-' + active : null" }
			@click="toggle()"
			@keydown.arrow-down.prevent="move(1)"
			@keydown.arrow-up.prevent="move(-1)"
			@keydown.home.prevent="jump(0)"
			@keydown.end.prevent="jump(opts.length - 1)"
			@keydown.enter.prevent="open ? pick(active) : toggle()"
			@keydown.space.prevent="open ? pick(active) : toggle()"
			@keydown="if(open && $event.key.length === 1) typeahead($event.key)"
			class="cp-field clip-tag flex items-center justify-between w-full text-left"
		>
			<span x-text="labelOf(sel) || '{ placeholder }'" :class="!sel && 'text-muted'"></span>
			<span class="text-accent transition-transform" :class="open && 'rotate-180'">▾</span>
		</button>
		<!-- Hidden form-bearing input — carries the selected value AND any
		     dynamic disabled/value attributes the caller forwards via Attrs. -->
		<input
			type="hidden"
			name={ p.Name }
			:value="sel"
			required?={ p.Required }
			{ p.Attrs... }
		/>
		<ul
			id={ listID }
			role="listbox"
			tabindex="-1"
			aria-labelledby={ btnID }
			x-show="open"
			x-cloak
			x-transition.opacity.duration.150ms
			class="absolute z-10 top-full left-0 right-0 mt-1 bg-panel border border-accent clip-panel max-h-52 overflow-auto py-1"
		>
			for i, o := range p.Opts {
				{{idx := i
optID := listID + "-opt-" + itoa(i)
				}}
				<li
					id={ optID }
					x-ref={ "opt-" + itoa(idx) }
					role="option"
					:aria-selected={ "sel === '" + o.Value + "'" }
					@click={ "pick(" + itoa(idx) + ")" }
					@mouseenter={ "active = " + itoa(idx) }
					:class={
						"sel === '" + o.Value + "' " +
							"? 'bg-primary text-primary-fg' " +
							": (active === " + itoa(idx) + " ? 'bg-accent/15 text-accent' : 'hover:bg-accent/10')",
					}
					class="cursor-pointer px-3 py-2 font-mono text-xs uppercase tracking-widest"
				>
					{ o.Label }
				</li>
			}
		</ul>
	</div>
}

// FilterSelectProps — a HTMX-driven single-select filter for "filter a list"
// use cases (search bars, role pickers, status filters, etc.).
//
// What it does differently from Droplist:
//   - Fires an HTMX request on every selection change (hx-get to URL).
//   - Optional Include CSS selector to bundle sibling filter inputs (e.g.
//     a search box) so combined filters work out of the box.
//   - Shows an "active" highlight + a one-click Clear chip when a non-default
//     value is selected, so users always see which filters are applied.
//   - Built-in inline spinner that lights up while a request is in flight
//     (HTMX adds `.htmx-request` to the element making the request).
//
// `disabled` and dynamic attrs flow through Attrs onto the hidden input that
// fires the actual HTMX request — keeping the static/dynamic split consistent
// with the rest of the selection components.
type FilterSelectProps struct {
	Name        string
	Label       string       // optional label above the trigger
	Selected    string       // initially-selected option value (empty = default/all)
	Placeholder string       // shown when nothing selected (defaults to "All")
	Icon        string       // optional leading glyph (e.g. "◇", "▣", "⌖")
	Opts        []DropOption // selectable options (do NOT include a "(all)" entry — Placeholder covers it)
	// HTMX wiring
	URL     string // hx-get target (required)
	Target  string // hx-target CSS selector (required, e.g. "#users-list")
	Swap    string // hx-swap (defaults to "innerHTML")
	Include string // hx-include selector to bundle sibling inputs (e.g. "[name='search']")
	Trigger string // hx-trigger override (defaults to "change")
	PushURL bool   // hx-push-url (defaults to false)
	Attrs   templ.Attributes
}

// FilterSelect renders a cyberpunk-styled filter dropdown that re-queries an
// endpoint via HTMX whenever the user changes the selection.
//
// Implementation notes:
//   • The styled trigger + popup mirror Droplist's ARIA combobox pattern, so
//     keyboard support and screen-reader semantics are identical.
//   • The actual HTMX-firing element is a hidden <input>; when the Alpine
//     `sel` state changes we dispatch a native `change` event on it, which
//     HTMX listens for. This means HTMX handles all the request mechanics
//     (debounce, swap, history, indicators) — Alpine only manages UI state.
//   • A `Clear` chip appears next to the trigger when a non-default value is
//     selected. Clicking it resets `sel = ''` and re-fires the request.
templ FilterSelect(p FilterSelectProps) {
	{{placeholder := p.Placeholder
if placeholder == "" {
	placeholder = "All"
}
	}}
	{{swap := p.Swap
if swap == "" {
	swap = "innerHTML"
}
	}}
	{{trigger := p.Trigger
if trigger == "" {
	trigger = "change"
}
	}}
	{{listID := p.Name + "-listbox"
btnID := p.Name + "-trigger"
inputID := p.Name + "-input"
	}}
	<div
		x-data={ "{ open:false, sel: '" + p.Selected + "', active: -1, " +
				"opts: " + dropOptsToJS(p.Opts) + ", " +
				"labelOf(v){ const o = this.opts.find(x => x.v === v); return o ? o.l : ''; }, " +
				"toggle(){ this.open = !this.open; if(this.open){ this.active = Math.max(0, this.opts.findIndex(o => o.v === this.sel)); this.$nextTick(()=>this.scrollActive()); } }, " +
				"pick(i){ if(i<0||i>=this.opts.length) return; this.setVal(this.opts[i].v); this.open = false; this.$refs.trigger.focus(); }, " +
				"clear(){ this.setVal(''); this.$refs.trigger.focus(); }, " +
				"setVal(v){ if(this.sel === v) return; this.sel = v; this.$nextTick(() => this.$refs.input.dispatchEvent(new Event('change', {bubbles:true}))); }, " +
				"move(d){ if(!this.open){ this.open = true; this.active = Math.max(0, this.active); } " +
				"else { this.active = (this.active + d + this.opts.length) % this.opts.length; } this.$nextTick(()=>this.scrollActive()); }, " +
				"jump(i){ this.open = true; this.active = i; this.$nextTick(()=>this.scrollActive()); }, " +
				"typeahead(k){ if(!/^[a-z0-9]$/i.test(k)) return; const start = (this.active + 1) % this.opts.length; " +
				"for(let n=0; n<this.opts.length; n++){ const i = (start + n) % this.opts.length; " +
				"if(this.opts[i].l.toLowerCase().startsWith(k.toLowerCase())){ this.jump(i); return; } } }, " +
				"scrollActive(){ const el = this.$refs['opt-'+this.active]; if(el && el.scrollIntoView) el.scrollIntoView({block:'nearest'}); } }" }
		@keydown.escape.window="if(open){ open = false; $refs.trigger.focus(); }"
		@click.away="open = false"
		class="relative h-fit self-start inline-flex items-stretch gap-2 flex-wrap"
	>
		<div class="relative h-fit self-start">
			if p.Label != "" {
				<label for={ btnID } class="block font-mono text-[10px] text-accent uppercase tracking-widest mb-1">{ p.Label }</label>
			}
			<button
				id={ btnID }
				x-ref="trigger"
				type="button"
				role="combobox"
				aria-haspopup="listbox"
				aria-controls={ listID }
				:aria-expanded="open.toString()"
				:aria-activedescendant={ "open && active >= 0 ? '" + listID + "-opt-' + active : null" }
				@click="toggle()"
				@keydown.arrow-down.prevent="move(1)"
				@keydown.arrow-up.prevent="move(-1)"
				@keydown.home.prevent="jump(0)"
				@keydown.end.prevent="jump(opts.length - 1)"
				@keydown.enter.prevent="open ? pick(active) : toggle()"
				@keydown.space.prevent="open ? pick(active) : toggle()"
				@keydown="if(open && $event.key.length === 1) typeahead($event.key)"
				:class="sel ? 'border-primary text-primary ring-1 ring-primary/30' : ''"
				class="cp-field clip-tag flex items-center gap-2 w-full text-left transition-colors"
			>
				if p.Icon != "" {
					<span class="text-accent font-mono text-sm flex-none" aria-hidden="true">{ p.Icon }</span>
				}
				<span class="flex-1 truncate" x-text={ "labelOf(sel) || '" + placeholder + "'" } :class="!sel && 'text-muted'"></span>
				<!-- Inline spinner — visible only while the hidden input is making an HTMX request -->
				<span class="htmx-indicator cp-spinner flex-none" style="width:12px;height:12px;border-width:1.5px"></span>
				<span class="text-accent transition-transform flex-none" :class="open && 'rotate-180'">▾</span>
			</button>
		</div>
		<!-- Hidden form-bearing input — this is the element HTMX actually wires onto.
		     We dispatch a synthetic `change` event from Alpine on every selection,
		     and HTMX handles the request + target swap from there. -->
		<input
			id={ inputID }
			x-ref="input"
			type="hidden"
			name={ p.Name }
			:value="sel"
			hx-get={ p.URL }
			hx-trigger={ trigger }
			hx-target={ "#" + p.Target }
			hx-swap={ swap }
			if p.PushURL {
				hx-push-url="true"
			}
			if p.Include != "" {
				hx-include={ p.Include }
			}
			hx-indicator={ "#" + btnID + " .htmx-indicator" }
			{ p.Attrs... }
		/>
		<!-- One-click clear chip — only rendered when a non-default value is active -->
		<button
			type="button"
			x-show="sel"
			x-cloak
			x-transition.opacity.duration.100ms
			@click="clear()"
			class="cp-field clip-tag inline-flex items-center gap-1 px-2 font-mono text-[10px] uppercase tracking-widest border-error/60 text-error hover:bg-error/10"
			aria-label="Clear filter"
		>
			<span aria-hidden="true">×</span>
			<span>Clear</span>
		</button>
		<ul
			id={ listID }
			role="listbox"
			tabindex="-1"
			aria-labelledby={ btnID }
			x-show="open"
			x-cloak
			x-transition.opacity.duration.150ms
			class="absolute z-10 top-full left-0 mt-1 min-w-full bg-panel border border-accent clip-panel max-h-52 overflow-auto py-1"
		>
			<!-- Placeholder/clear row — picking it resets the filter -->
			<li
				role="option"
				:aria-selected="sel === ''"
				@click="pick(-1); setVal('')"
				:class="!sel ? 'bg-primary text-primary-fg' : 'hover:bg-accent/10 text-muted'"
				class="cursor-pointer px-3 py-2 font-mono text-xs uppercase tracking-widest italic"
			>{ placeholder }</li>
			for i, o := range p.Opts {
				{{idx := i
optID := listID + "-opt-" + itoa(i)
				}}
				<li
					id={ optID }
					x-ref={ "opt-" + itoa(idx) }
					role="option"
					:aria-selected={ "sel === '" + o.Value + "'" }
					@click={ "pick(" + itoa(idx) + ")" }
					@mouseenter={ "active = " + itoa(idx) }
					:class={
						"sel === '" + o.Value + "' " +
							"? 'bg-primary text-primary-fg' " +
							": (active === " + itoa(idx) + " ? 'bg-accent/15 text-accent' : 'hover:bg-accent/10')",
					}
					class="cursor-pointer px-3 py-2 font-mono text-xs uppercase tracking-widest"
				>{ o.Label }</li>
			}
		</ul>
	</div>
}

// ComboboxProps — searchable multi-select.
type ComboboxProps struct {
	Name        string
	Label       string
	Placeholder string
	All         []string
	Initial     []string
}

// Combobox is a searchable multi-select. Posts the selection as a CSV hidden input.
templ Combobox(p ComboboxProps) {
	<div
		x-data={ "{ all: " + jsStringArray(p.All) + ", sel: " + jsStringArray(p.Initial) + ", " +
				"q:'', open:false, " +
				"get filtered(){ return this.all.filter(x => x.toLowerCase().includes(this.q.toLowerCase())); }, " +
				"toggle(x){ this.sel.includes(x) ? this.sel = this.sel.filter(y => y !== x) : this.sel.push(x); } }" }
	>
		if p.Label != "" {
			@FieldLabel(p.Label, "")
		}
		<div class="relative h-fit self-start">
			<div
				class="cp-field clip-tag flex flex-wrap gap-1 items-center min-h-[44px]"
				@click="open = true; $refs.q.focus()"
			>
				<template x-for="t in sel" :key="t">
					<span class="clip-tag bg-accent text-accent-fg font-mono text-[11px] uppercase px-2 py-0.5 flex items-center gap-1">
						<span x-text="t"></span>
						<button type="button" @click.stop="toggle(t)" class="hover:text-error" aria-label="Remove">✕</button>
					</span>
				</template>
				<input
					x-ref="q"
					x-model="q"
					@focus="open = true"
					@click.away="open = false"
					placeholder={ nonEmpty(p.Placeholder, "search…") }
					class="bg-transparent outline-none text-sm font-mono flex-1 min-w-[120px]"
				/>
			</div>
			<input type="hidden" name={ p.Name } :value="sel.join(',')"/>
			<div
				x-show="open"
				x-cloak
				x-transition.opacity
				class="absolute z-10 top-full left-0 right-0 mt-1 bg-panel border border-accent clip-panel max-h-52 overflow-auto"
				role="listbox"
			>
				<template x-for="o in filtered" :key="o">
					<button
						type="button"
						@click="toggle(o)"
						class="w-full text-left px-3 py-2 font-mono text-xs uppercase tracking-widest flex items-center justify-between hover:bg-accent/10"
					>
						<span x-text="o"></span>
						<span x-show="sel.includes(o)" class="text-primary">✓</span>
					</button>
				</template>
				<div x-show="!filtered.length" class="px-3 py-2 font-mono text-xs text-muted">no matches</div>
			</div>
		</div>
	</div>
}

// FilterChipsProps — toggle-able tag chips. Selection is live in Alpine.
type FilterChipsProps struct {
	Name    string
	Label   string
	Options []string
	Initial []string
}

// FilterChips is a multi-select chip row (stealth/combat/hack/…). Submits as CSV.
templ FilterChips(p FilterChipsProps) {
	<div
		x-data={ "{ f: " + jsStringArray(p.Initial) + " }" }
	>
		if p.Label != "" {
			@FieldLabel(p.Label, "")
		}
		<div class="flex flex-wrap gap-1.5">
			for _, t := range p.Options {
				<button
					type="button"
					@click={ "f.includes('" + t + "') ? f = f.filter(x => x !== '" + t + "') : f.push('" + t + "')" }
					:class={ "f.includes('" + t + "') ? 'bg-primary text-primary-fg' : 'border border-accent text-accent hover:bg-accent/10'" }
					class="clip-tag px-3 py-1 font-mono text-[11px] uppercase tracking-widest"
				>
					{ t }
				</button>
			}
		</div>
		<input type="hidden" name={ p.Name } :value="f.join(',')"/>
	</div>
}

// RangeProps — themed slider with live numeric readout.
type RangeProps struct {
	Name  string
	Label string
	Min   int
	Max   int
	Step  int
	Value int
	Unit  string // e.g. "%", "ms", "km/h"
}

// Range is a slider with a coloured diamond thumb and a live-updating value chip.
templ Range(p RangeProps) {
	{{step := p.Step
if step == 0 {
	step = 1
}
	}}
	<div x-data={ "{ v: " + itoa(p.Value) + " }" }>
		if p.Label != "" {
			<div class="font-mono text-[11px] text-accent uppercase tracking-widest mb-1 flex justify-between">
				<span>{ p.Label }</span>
				<span class="text-primary">
					<span x-text="v"></span>{ p.Unit }
				</span>
			</div>
		}
		<input
			type="range"
			name={ p.Name }
			min={ itoa(p.Min) }
			max={ itoa(p.Max) }
			step={ itoa(step) }
			x-model.number="v"
			class="cp-range"
		/>
	</div>
}
