package ui

// PasswordProps — masked input with show/hide toggle, optional live strength
// meter, and optional rule-based validation.
//
// Rule fields are independent. Setting any of them turns on a reactive `err`
// state that surfaces the first failing rule under the entropy meter (or
// directly under the field when ShowStrength is off). All validation is
// purely client-side via Alpine — server-side validation should still be
// performed independently.
type PasswordProps struct {
	Name        string
	Label       string
	Placeholder string
	Value       string
	Required    bool
	// ShowStrength renders a 4-segment entropy meter beneath the field.
	ShowStrength bool
	// MinLen, when > 0, requires the password to be at least N characters.
	MinLen int
	// RequireNumber requires at least one [0-9] digit.
	RequireNumber bool
	// RequireCaps requires at least one [A-Z] uppercase letter.
	RequireCaps bool
	// RequireSymbol requires at least one non-word character.
	RequireSymbol bool

	Attrs templ.Attributes
}

// 4-bar entropy meter based on length + charset variety. Set any of MinLen /
// RequireNumber / RequireCaps / RequireSymbol to add live rule validation
// surfaced through a reactive `err` string under the meter.
templ SecurePasswordInput(p PasswordProps) {
	{{ minLenStr := itoa(p.MinLen) }}
	{{reqNum := "false"
if p.RequireNumber {
	reqNum = "true"
}
	}}
	{{reqCap := "false"
if p.RequireCaps {
	reqCap = "true"
}
	}}
	{{reqSym := "false"
if p.RequireSymbol {
	reqSym = "true"
}
	}}
	{{ hasRules := p.MinLen > 0 || p.RequireNumber || p.RequireCaps || p.RequireSymbol }}
	<div
		x-data={ "{ show:false, v: '" + p.Value + "', err: '', " +
				"minLen: " + minLenStr + ", reqNum: " + reqNum + ", reqCap: " + reqCap + ", reqSym: " + reqSym + ", " +
				"score(){ let s=0; " +
				"if(this.v.length>=8)s++; " +
				"if(/[A-Z]/.test(this.v))s++; " +
				"if(/[0-9]/.test(this.v))s++; " +
				"if(/[^\\w]/.test(this.v))s++; return s; }, " +
				"validate(){ " +
				"if(!this.v.length){ this.err=''; return; } " +
				"if(this.minLen && this.v.length < this.minLen){ this.err = 'min ' + this.minLen + ' chars required'; return; } " +
				"if(this.reqCap && !/[A-Z]/.test(this.v)){ this.err = 'uppercase letter required'; return; } " +
				"if(this.reqNum && !/[0-9]/.test(this.v)){ this.err = 'number required'; return; } " +
				"if(this.reqSym && !/[^\\w]/.test(this.v)){ this.err = 'symbol required'; return; } " +
				"this.err = ''; } }" }
	>
		if p.Label != "" {
			@FieldLabel(p.Label, "")
		}
		<div class="relative">
			<input
				:type="show ? 'text' : 'password'"
				name={ p.Name }
				x-model="v"
				if hasRules {
					@input="validate()"
					@blur="validate()"
					:aria-invalid="!!err"
				}
				placeholder={ nonEmpty(p.Placeholder, "••••••••") }
				required?={ p.Required }
				class="cp-field clip-tag pr-12"
				autocomplete="current-password"
				{ p.Attrs... }
			/>
			<button
				type="button"
				@click="show = !show"
				class="absolute right-2 top-1/2 -translate-y-1/2 text-accent font-mono text-[10px] uppercase"
				aria-label="Toggle password visibility"
			>
				<span x-text="show ? 'hide' : 'show'"></span>
			</button>
		</div>
		if p.ShowStrength {
			<div class="mt-2 grid grid-cols-4 gap-1" aria-hidden="true">
				<template x-for="i in 4" :key="i">
					<div
						class="h-1"
						:class="score() >= i
							? (score()===1 ? 'bg-error' : score()===2 ? 'bg-warning' : score()===3 ? 'bg-info' : 'bg-success')
							: 'bg-border'"
					></div>
				</template>
			</div>
			<div class="mt-1 font-mono text-[10px] text-muted">
				entropy:
				<span class="text-accent" x-text="['none','weak','ok','good','strong'][score()]"></span>
			</div>
		}
		if hasRules {
			<p
				x-show="err"
				x-cloak
				x-text="'// ' + err"
				class="mt-1 font-mono text-[10px] text-error uppercase tracking-widest"
				role="alert"
				aria-live="polite"
			></p>
		}
	</div>
}

// OTPProps — N-digit one-time-code input rendered as separated cells. Driven
// by a single hidden <input> overlaid on the cells so paste, autocomplete
// "one-time-code", iOS SMS auto-fill, and form submission all work without
// per-cell focus management. The cell at index v.length is highlighted while
// focused, mimicking a per-cell caret.
//
// AutoSubmit fires requestSubmit() on the closest <form> as soon as the
// user types the Length-th digit. PostURL/TargetID still work as a manual
// "Verify" button below the row when AutoSubmit is off.
type OTPProps struct {
	Name       string // becomes both id and name
	Label      string
	Length     int // defaults to 6 when 0
	Required   bool
	AutoSubmit bool
	Attrs      templ.Attributes
}

// OTP renders a row of separated cyberpunk cells driven by one hidden input.
templ OTP(p OTPProps) {
	{{length := p.Length
if length == 0 {
	length = 6
}
	}}
	{{ lenStr := itoa(length) }}
	{{ submitJS := "" }}
	{{if p.AutoSubmit {
	submitJS = "; if(v.length===" + lenStr + " && $el.form){ $nextTick(()=>$el.form.requestSubmit()) }"
}
	}}
	<div x-data={ "{ v: '', focused: false, len: " + lenStr + " }" }>
		if p.Label != "" {
			@FieldLabel(p.Label, p.Name)
		}
		<div class="relative" @click="$refs.otp.focus()">
			<div class="flex gap-2 sm:gap-3 pointer-events-none select-none" aria-hidden="true">
				<template x-for="i in len" :key="i">
					<div
						:autofocus="(i - 1) === Math.min(v.length, len - 1)"
						class="flex-1 aspect-square max-w-14 grid place-items-center clip-tag border-2 transition-all font-mono text-2xl"
						:class="
							focused && (i - 1) === Math.min(v.length, len - 1)
								? 'border-primary bg-primary/10 text-primary shadow-[0_0_12px_var(--color-primary)]'
								: v[i-1]
									? 'border-accent text-primary bg-panel'
									: 'border-border bg-panel/60 text-muted'
						"
					>
						<span x-text="v[i-1] || ''"></span>
					</div>
				</template>
			</div>
			<input
				x-ref="otp"
				type="text"
				id={ p.Name }
				name={ p.Name }
				inputmode="numeric"
				pattern="[0-9]*"
				maxlength={ lenStr }
				autofocus="true"
				autocomplete="one-time-code"
				required?={ p.Required }
				x-model="v"
				@focus="focused = true"
				@blur="focused = false"
				@input={ "v = $event.target.value.replace(/\\D/g,'').slice(0," + lenStr + "); $event.target.value = v" + submitJS }
				class="absolute inset-0 w-full h-full opacity-0 cursor-pointer focus:outline-none"
				style="caret-color: transparent;"
				aria-label={ nonEmpty(p.Label, "One-time code") }
				{ p.Attrs... }
			/>
		</div>
		if  !p.AutoSubmit {
			<div class="mt-3">
				@Button(ButtonProps{
					Variant: ButtonPrimary,
					Size:    ButtonSM,
					Type:    TypeSubmit,
					Attrs: templ.Attributes{
						"x-bind:disabled": "v.length !== len",
					},
				}) {
					Verify
				}
			</div>
		}
	</div>
}

// OTPSingleProps — single-field numeric one-time-code input. Distinct from
// the multi-cell @OTP component: this renders one wide field with letter-spaced
// digits, ideal for compact 2FA / magic-link flows where per-cell focus jumps
// would feel heavy.
//
// Sanitisation: every keystroke strips non-digits and clamps to Length, so
// pasted strings like "123 456" become "123456" automatically.
//
// AutoSubmit, when true, fires `requestSubmit()` on the closest <form> as
// soon as the user types the Length-th digit. requestSubmit() is interceptable
// by both native form handlers and HTMX, so it works inside hx-post / hx-boost
// forms without extra wiring.
type OTPSingleProps struct {
	Name       string // becomes both id and name
	Label      string
	Hint       string
	Length     int // defaults to 6 when 0
	Required   bool
	AutoSubmit bool
	Attrs      templ.Attributes
}

// CyberOTPInput is a single-field numeric one-time-code input styled for the
// cyberpunk theme: clip-tag corner cuts, mono digits, wide letter-spacing.
templ CyberOTPInput(p OTPSingleProps) {
	{{length := p.Length
if length == 0 {
	length = 6
}
	}}
	{{ lenStr := itoa(length) }}
	{{ submitJS := "" }}
	{{if p.AutoSubmit {
	submitJS = "; if(v.length===" + lenStr + " && $el.form){ $nextTick(()=>$el.form.requestSubmit()) }"
}
	}}
	<div x-data="{ v: '' }">
		if p.Label != "" {
			@FieldLabel(p.Label, p.Name)
		}
		<input
			type="text"
			id={ p.Name }
			name={ p.Name }
			inputmode="numeric"
			pattern="[0-9]*"
			maxlength={ lenStr }
			placeholder={ repeat("0", length) }
			autocomplete="one-time-code"
			required?={ p.Required }
			x-model="v"
			@input={ "v = $event.target.value.replace(/\\D/g,'').slice(0," + lenStr + "); $event.target.value = v" + submitJS }
			class="cp-field clip-tag text-center font-mono text-2xl tracking-[0.5em] text-primary placeholder:text-muted/50"
			{ p.Attrs... }
		/>
		if p.Hint != "" {
			<p class="mt-1 font-mono text-[10px] text-muted uppercase tracking-widest">\\ { p.Hint }</p>
		}
	</div>
}

// CodeInputProps — generic alphanumeric code field for license keys, backup
// codes, redemption codes, recovery phrases (single token), etc.
//
// MaxLength defaults to 21 (matches typical XXXXX-XXXXX-XXXXX-XXX shapes).
// Set Uppercase=true to display + submit the code in upper-case as the user
// types — useful for license-style codes where casing is irrelevant. The
// browser's autocapitalize is also flipped to "characters" in that mode.
//
// AutoSubmit fires requestSubmit() on the closest form when the user types
// the MaxLength-th character; works with both native and hx-* forms.
type CodeInputProps struct {
	Name        string
	Label       string
	Hint        string
	MaxLength   int    // defaults to 21 when 0
	Placeholder string // defaults to "ENTER CODE"
	Required    bool
	Uppercase   bool
	AutoSubmit  bool
	Attrs       templ.Attributes
}

// CyberCodeInput is a single-field alphanumeric code input styled for the
// cyberpunk theme.
templ CyberCodeInput(p CodeInputProps) {
	{{maxLen := p.MaxLength
if maxLen == 0 {
	maxLen = 21
}
	}}
	{{ maxLenStr := itoa(maxLen) }}
	{{caseJS := ""
if p.Uppercase {
	caseJS = ".toUpperCase()"
}
	}}
	{{ submitJS := "" }}
	{{if p.AutoSubmit {
	submitJS = "; if(v.length===" + maxLenStr + " && $el.form){ $nextTick(()=>$el.form.requestSubmit()) }"
}
	}}
	{{autoCap := "off"
if p.Uppercase {
	autoCap = "characters"
}
	}}
	<div x-data="{ v: '' }">
		if p.Label != "" {
			@FieldLabel(p.Label, p.Name)
		}
		<input
			type="text"
			id={ p.Name }
			name={ p.Name }
			placeholder={ nonEmpty(p.Placeholder, "ENTER CODE") }
			required?={ p.Required }
			maxlength={ maxLenStr }
			autocomplete="off"
			autocapitalize={ autoCap }
			spellcheck="false"
			x-model="v"
			@input={ "v = $event.target.value" + caseJS + ".slice(0," + maxLenStr + "); $event.target.value = v" + submitJS }
			class={
				"cp-field clip-tag text-center font-mono text-lg tracking-wider text-primary placeholder:text-muted/50",
				templ.KV("uppercase", p.Uppercase),
			}
			{ p.Attrs... }
		/>
		if p.Hint != "" {
			<p class="mt-1 font-mono text-[10px] text-muted uppercase tracking-widest">\\ { p.Hint }</p>
		}
	</div>
}

// TagInputProps — list of short tag strings with inline add/remove.
type TagInputProps struct {
	Name        string // rendered as a hidden CSV input so it submits with the form
	Label       string
	Initial     []string
	Placeholder string
}

// TagInput is a pill-based multi-value input. Enter or comma commits; Backspace
// on an empty draft removes the last tag.
templ TagInput(p TagInputProps) {
	<div
		x-data={ "{ tags: " + jsStringArray(p.Initial) + ", draft: '', " +
				"add(){ const v=this.draft.trim(); if(v && !this.tags.includes(v)) this.tags.push(v); this.draft=''; }, " +
				"remove(t){ this.tags = this.tags.filter(x => x !== t); } }" }
	>
		if p.Label != "" {
			@FieldLabel(p.Label, "")
		}
		<div class="cp-field clip-tag flex flex-wrap gap-1 items-center min-h-[44px]">
			<template x-for="t in tags" :key="t">
				<span class="clip-tag bg-primary text-primary-fg font-mono text-[11px] uppercase px-2 py-0.5 flex items-center gap-1">
					<span x-text="t"></span>
					<button type="button" @click="remove(t)" class="text-primary-fg/80 hover:text-error" aria-label="Remove tag">✕</button>
				</span>
			</template>
			<input
				x-model="draft"
				@keydown.enter.prevent="add()"
				@keydown.comma.prevent="add()"
				@keydown.backspace="if(!draft && tags.length) tags.pop()"
				placeholder={ nonEmpty(p.Placeholder, "type + Enter") }
				class="bg-transparent outline-none text-sm font-mono flex-1 min-w-[120px]"
			/>
		</div>
		<input type="hidden" name={ p.Name } :value="tags.join(',')"/>
	</div>
}

// FileUploadProps — drag-and-drop zone with a selected-files preview list.
type FileUploadProps struct {
	Name     string
	Label    string
	Accept   string // MIME filter e.g. ".png,.jpg,image/*"
	Multiple bool
	// PostURL, when set, posts the files via multipart hx-post on `change`.
	PostURL  string
	TargetID string
	Hint     string // overrides the default "max 10MB" line
}

// FileUpload is a themed dropzone + picker. Client-side preview list appears as
// files are added; server upload kicks off automatically if PostURL is provided.
templ FileUpload(p FileUploadProps) {
	<div
		x-data="{
			over:false, files:[],
			onDrop(e){ this.over=false; this.add([...e.dataTransfer.files]); },
			onPick(e){ this.add([...e.target.files]); },
			add(list){ this.files = [...this.files, ...list]; },
			rm(i){ this.files.splice(i,1); },
			size(b){ const u=['B','KB','MB','GB']; let i=0; while(b>=1024 && i<u.length-1){ b/=1024; i++; } return b.toFixed(1)+u[i]; }
		}"
	>
		if p.Label != "" {
			<div class="font-mono text-[11px] text-accent uppercase tracking-widest mb-1">{ p.Label }</div>
		}
		<label
			@dragover.prevent="over=true"
			@dragleave.prevent="over=false"
			@drop.prevent="onDrop($event)"
			:class="over ? 'border-primary bg-primary/10' : 'border-accent/50'"
			class="clip-panel block p-6 border-2 border-dashed text-center cursor-pointer transition-colors"
		>
			<svg class="mx-auto text-accent" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
				<path d="M12 16V4m0 0l-4 4m4-4l4 4M4 20h16"></path>
			</svg>
			<div class="mt-2 font-mono text-xs text-accent uppercase tracking-widest">
				Drop shards or <span class="text-primary">browse</span>
			</div>
			<div class="mt-1 font-mono text-[10px] text-muted">{ nonEmpty(p.Hint, "max 10MB") }</div>
			if p.PostURL != "" {
				<input
					type="file"
					name={ p.Name }
					accept={ p.Accept }
					multiple?={ p.Multiple }
					class="sr-only"
					@change="onPick($event)"
					hx-post={ p.PostURL }
					hx-encoding="multipart/form-data"
					hx-trigger="change"
					hx-target={ "#" + p.TargetID }
				/>
			} else {
				<input
					type="file"
					name={ p.Name }
					accept={ p.Accept }
					multiple?={ p.Multiple }
					class="sr-only"
					@change="onPick($event)"
				/>
			}
		</label>
		<ul class="mt-3 space-y-1" x-show="files.length">
			<template x-for="(f,i) in files" :key="i">
				<li class="flex items-center justify-between gap-2 font-mono text-xs px-2 py-1 bg-panel border-l-2 border-accent">
					<span class="truncate"><span class="text-primary" x-text="f.name"></span></span>
					<span class="text-muted flex-none" x-text="size(f.size)"></span>
					<button type="button" @click="rm(i)" class="text-error" aria-label="Remove file">✕</button>
				</li>
			</template>
		</ul>
	</div>
}
