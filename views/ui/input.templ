package ui

import "strconv"
import "fmt"

templ StringInput(id string, typology string, label string, required bool) {
	<div class="flex flex-col w-full p-2 justify-around">
		<label for={ id } class="w-fit p-1 backdrop-blur-xl rounded bg-opacity-20! text-green-900">
			{ label }
		</label>
		<input class="border-b-2 border-solid bg-transparent outline-none mb-3 border-green-500 text-green-500" id={ id } name={ id } type={ typology } required?={ required }/>
	</div>
}

templ SimpleCheckboxInput(id string, label string, required bool) {
	<div class="m-1">
		<input type="checkbox" id={ id } name={ id } required?={ required } class="h-4 w-4"/>
		<label for={ id }>{ label }</label>
	</div>
}

templ RadioInput(id string, name string, label string, value string, required bool) {
	<div class="radio">
		<input id={ id } name={ name } type="radio" value={ value } required?={ required }/>
		<label for={ id } class="radio-label">{ label }</label>
	</div>
}

templ RadioField(id string, label string, required bool) {
	<fieldset>
		<legend>{ label }</legend>
		@RadioInput(id+"y", id, "Yes", "1", required)
		@RadioInput(id+"n", id, "No", "0", required)
	</fieldset>
}

templ SexRadioField(id string, label string, required bool) {
	<fieldset>
		<legend>{ label }</legend>
		@RadioInput(id+"y", id, "Male", "male", required)
		@RadioInput(id+"n", id, "Female", "female", required)
	</fieldset>
}

templ BoolRadioField(id string, label string, required bool) {
	<fieldset class="space-y-2">
		<legend class="text-sm md:text-base font-medium text-gray-900 mb-3 leading-relaxed">{ label }</legend>
		<div class="flex flex-wrap gap-3 md:gap-4">
			@RadioInput(id+"y", id, "True", "1", required)
			@RadioInput(id+"n", id, "False", "0", required)
		</div>
	</fieldset>
}

templ MultiRadioField(id string, label string, options []string, adjust int, required bool) {
	<fieldset>
		<legend>{ label }</legend>
		for index, option := range options {
			@RadioInput(id+strconv.Itoa(index), id, option, strconv.Itoa(index+adjust), required)
		}
	</fieldset>
}

templ HiddenInput(id string, value string) {
	<input type="hidden" id={ id } name={ id } value={ value }/>
}

templ DynamicHiddenInput(id string, value string) {
	<input type="hidden" id={ id } name={ id } :value={ value }/>
}

templ ModelOTPInput(id string) {
	<div>
		<label class="block text-sm font-medium text-primary mb-2">Verification Code</label>
		<input
			type="text"
			id={ id }
			x-model={ id }
			name={ id }
			inputmode="numeric"
			pattern="[0-9]*"
			maxlength="6"
			placeholder="000000"
			autocomplete="one-time-code"
			class="w-full px-4 py-3 rounded-lg border border-primary/20 bg-std text-primary text-center font-mono text-2xl tracking-[0.5em] placeholder-primary/30 focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary transition-all"
			required
		/>
	</div>
}

templ OTPInput(label string, hint string) {
	<div>
		<label for="otp" class="block text-sm font-medium text-primary mb-2">{ label }</label>
		<input
			type="text"
			id="otp"
			name="otp"
			inputmode="numeric"
			pattern="[0-9]*"
			maxlength="6"
			placeholder="000000"
			autocomplete="one-time-code"
			class="w-full px-4 py-3 rounded-lg border border-primary/20 bg-std text-primary text-center font-mono text-2xl tracking-[0.5em] placeholder-primary/30 focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary transition-all"
			required
		/>
		<p class="mt-1 text-xs text-primary/60">{ hint }</p>
	</div>
}

templ GenericCodeInput(id string, label string, hint string) {
	<div>
		<label for={ id } class="block text-sm font-medium text-primary mb-2">
			{ label }
		</label>
		<input
			type="text"
			id={ id }
			name={ id }
			placeholder={ fmt.Sprintf("Enter your %s", id) }
			required
			maxlength="21"
			class="w-full px-4 py-3 bg-std border border-primary/20 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition-all text-center text-lg font-mono tracking-wider text-primary"
		/>
		<p class="text-xs text-primary/60 mt-2">
			{ hint }
		</p>
	</div>
}

templ BasicInput(id string, label string, required bool) {
	<div>
		<label class="block text-sm font-medium text-primary mb-2" for={ id }>{ label }</label>
		<input
			type="text"
			id={ id }
			name={ id }
			class="w-full px-4 py-3 border-2 border-primary/20 rounded-xl bg-std text-primary placeholder:text-primary/50 focus:border-primary focus:ring-4 focus:ring-primary/10 outline-none transition-all duration-200"
			placeholder={ label }
			required?={ required }
		/>
	</div>
}

templ BasicModelInput(id string, placeholder string, required bool) {
	<div>
		<label class="block text-sm font-medium text-primary mb-2" for={ id }>
			{ children... }
		</label>
		<input
			type="text"
			id={ id }
			name={ id }
			x-model={ id }
			class="w-full px-4 py-3 border-2 border-primary/20 rounded-xl bg-std text-primary placeholder:text-primary/50 focus:border-primary focus:ring-4 focus:ring-primary/10 outline-none transition-all duration-200"
			placeholder={ placeholder }
			required?={ required }
		/>
	</div>
}

templ BasicModelPasswordInput(id string, required bool) {
	<div>
		<label class="block text-sm font-medium text-primary mb-2" for={ id }>
			{ children... }
		</label>
		<input
			type="password"
			id={ id }
			name={ id }
			x-model={ id }
			class="w-full px-4 py-3 border-2 border-primary/20 rounded-xl bg-std text-primary placeholder:text-primary/50 focus:border-primary focus:ring-4 focus:ring-primary/10 outline-none transition-all duration-200"
			placeholder="••••••••"
			required?={ required }
		/>
	</div>
}

templ BasicPasswordInput(id string, label string, required bool) {
	<div>
		<label class="block text-sm font-medium text-primary mb-2" for={ id }>{ label }</label>
		<input
			type="password"
			id={ id }
			name={ id }
			class="w-full px-4 py-3 border-2 border-primary/20 rounded-xl bg-std text-primary placeholder:text-primary/50 focus:border-primary focus:ring-4 focus:ring-primary/10 outline-none transition-all duration-200"
			placeholder="••••••••"
			required?={ required }
			minlength="8"
		/>
	</div>
}

templ BasicCheckbox(id string, label string, required bool, checked bool) {
	<div class="flex items-center gap-2">
		<input
			type="checkbox"
			id={ id }
			name={ id }
			class="w-4 h-4 rounded border-2 border-primary/20 accent-primary cursor-pointer"
			checked?={ checked }
			required?={ required }
		/>
		<label for={ id } class="text-sm text-primary/80 cursor-pointer">
			{ label }
		</label>
	</div>
}

templ BasicForgotPassword() {
	<a
		href="/reset"
		hx-boost="true"
		hx-push-url="true"
		hx-target="body"
		class="text-sm font-medium text-primary hover:text-accent transition-colors"
	>
		Forgot password?
	</a>
}

//////

// InputType is the typed enum over standard HTML <input type="..."> values.
// Pass one of the exported InputXxx constants to InputProps.Type. The zero
// value (an empty InputType) renders as "text", matching the HTML default.
type InputType string

const (
	InputText          InputType = "text"
	InputEmail         InputType = "email"
	InputPassword      InputType = "password" // prefer @Password for the full UX
	InputURL           InputType = "url"
	InputTel           InputType = "tel"
	InputNumber        InputType = "number"
	InputSearch        InputType = "search"
	InputDate          InputType = "date"
	InputTime          InputType = "time"
	InputDatetimeLocal InputType = "datetime-local"
	InputMonth         InputType = "month"
	InputWeek          InputType = "week"
	InputColor         InputType = "color"
	InputFile          InputType = "file"
	InputHidden        InputType = "hidden"
)

// String resolves the type attribute string, falling back to "text" when zero.
func (t InputType) String() string {
	if t == "" {
		return "text"
	}
	return string(t)
}

// FieldLabel is the shared label-chrome: uppercase tracking-wide caption, optional
// right-aligned hint (e.g. "required", "optional", character counters).
templ FieldLabel(label, hint string) {
	<div class="font-mono text-[11px] text-accent uppercase tracking-widest mb-1 flex justify-between">
		<span>{ label }</span>
		if hint != "" {
			<span class="text-muted">{ hint }</span>
		}
	</div>
}

templ DangerLabel(label, hint string) {
	<div class="font-mono text-[11px] neon-error flicker uppercase tracking-widest mb-1 flex justify-between">
		<span>{ label }</span>
		if hint != "" {
			<span class="text-muted">{ hint }</span>
		}
	</div>
}

// InputProps is the *static* config for @Input. Anything dynamic — current
// value, disabled state, validation errors, x-model, hx-* hooks, @blur
// handlers, :class, :aria-invalid, etc. — flows through Attrs and is owned
// by the parent's Alpine scope.
//
// The Name field doubles as the element's id so wrapping <label> clicks focus
// the input and external aria-describedby / aria-controls can target it.
//
// The component exposes a children slot for inline frontend feedback markup
// (error/help spans bound with x-show + x-text). See Input docs.
type InputProps struct {
	Name        string
	Type        InputType
	Label       string
	Hint        string
	Placeholder string
	Required    bool
	Danger      bool
	Attrs       templ.Attributes
}

// Input renders a labelled single-line field. Compose the parent's Alpine for
// any dynamic behaviour:
//
//	<div x-data="{ email: '', err: '' }">
//	    @Input(InputProps{
//	        Name: "email", Type: InputEmail, Label: "EMAIL", Required: true,
//	        Attrs: templ.Attributes{
//	            "x-model":      "email",
//	            ":disabled":    "loading",
//	            ":aria-invalid":"!!err",
//	            "@blur":        "err = /\\S+@\\S+\\.\\S+/.test(email) ? '' : 'invalid'",
//	        },
//	    }) {
//	        <p x-show="err" x-text="err" x-cloak
//	           class="mt-1 font-mono text-[11px] text-error"></p>
//	    }
//	</div>
templ Input(p InputProps) {
	<label class="block" x-data="{ err: '' }">
		if !p.Danger {
			@FieldLabel(p.Label, p.Hint)
		} else {
			@DangerLabel(p.Label, p.Hint)
		}
		<input
			type={ p.Type.String() }
			id={ p.Name }
			name={ p.Name }
			placeholder={ p.Placeholder }
			required?={ p.Required }
			class="cp-field clip-tag"
			{ p.Attrs... }
		/>
		<p x-show="err" x-text="'ERR: ' + err" x-cloak class="mt-1 font-mono text-[11px] text-error"></p>
	</label>
}

// TextareaProps — multi-line input. MaxLength > 0 enables a built-in live
// char counter rendered in the label hint slot; the count is read from the
// element's input event so it stays accurate even when the parent supplies
// its own x-model. Rows defaults to 3.
//
// Like @Input, the children slot is for parent-owned feedback (errors / help)
// and dynamic state flows through Attrs.
type TextareaProps struct {
	Name        string
	Label       string
	Placeholder string
	Rows        int
	MaxLength   int
	Required    bool
	Attrs       templ.Attributes
}

// Textarea is a labelled multi-line input.
templ Textarea(p TextareaProps) {
	if p.MaxLength > 0 {
		<div x-data="{ n: 0 }" x-init="$nextTick(() => { n = ($refs.ta && $refs.ta.value.length) || 0 })">
			<div class="font-mono text-[11px] text-accent uppercase tracking-widest mb-1 flex justify-between">
				<span>{ p.Label }</span>
				<span class="text-muted"><span x-text="n"></span>/{ itoa(p.MaxLength) }</span>
			</div>
			<textarea
				x-ref="ta"
				@input="n = $el.value.length"
				id={ p.Name }
				name={ p.Name }
				placeholder={ p.Placeholder }
				rows={ itoa(nonZero(p.Rows, 3)) }
				required?={ p.Required }
				maxlength={ itoa(p.MaxLength) }
				class="cp-field clip-tag resize-none"
				{ p.Attrs... }
			></textarea>
			{ children... }
		</div>
	} else {
		<label class="block">
			@FieldLabel(p.Label, "")
			<textarea
				id={ p.Name }
				name={ p.Name }
				placeholder={ p.Placeholder }
				rows={ itoa(nonZero(p.Rows, 3)) }
				required?={ p.Required }
				class="cp-field clip-tag resize-none"
				{ p.Attrs... }
			></textarea>
			{ children... }
		</label>
	}
}

// SearchProps — search field with a leading magnifier and HTMX live-search hooks.
//   - TargetID: id of the container live results swap into (renders below)
//   - GetURL:   server endpoint returning result HTML; required when TargetID is set
//   - DebounceMS: debounce on the keyup trigger; 0 → 300ms
//
// Dynamic value / disabled / aria state belong on Attrs.
type SearchProps struct {
	Name        string
	Label       string
	Placeholder string
	TargetID    string
	GetURL      string
	DebounceMS  int
	Include     string
	Attrs       templ.Attributes
}

// Search is a debounced live-search input. Renders the results target container
// directly below when TargetID is provided.
templ Search(p SearchProps) {
	<div>
		if p.Label != "" {
			@FieldLabel(p.Label, "")
		}
		<div class="relative">
			<svg class="absolute left-3 top-1/2 -translate-y-1/2 text-muted pointer-events-none" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
				<circle cx="11" cy="11" r="7"></circle>
				<line x1="21" y1="21" x2="16.5" y2="16.5"></line>
			</svg>
			if p.TargetID != "" && p.GetURL != "" {
				<input
					type="search"
					id={ nonEmpty(p.Name, "q") }
					name={ nonEmpty(p.Name, "q") }
					placeholder={ nonEmpty(p.Placeholder, "search…") }
					class="cp-field clip-tag pl-9"
					hx-get={ p.GetURL }
					hx-trigger={ "keyup changed delay:" + itoa(nonZero(p.DebounceMS, 300)) + "ms" }
					hx-target={ "#" + p.TargetID }
					hx-swap="innerHTML"
					if p.Include != "" {
						hx-include={ p.Include }
					}
					{ p.Attrs... }
				/>
			} else {
				<input
					type="search"
					id={ nonEmpty(p.Name, "q") }
					name={ nonEmpty(p.Name, "q") }
					placeholder={ nonEmpty(p.Placeholder, "search…") }
					class="cp-field clip-tag pl-9"
					{ p.Attrs... }
				/>
			}
		</div>
		if p.TargetID != "" {
			<div id={ p.TargetID } class="mt-2 font-mono text-[11px] text-muted"></div>
		}
		{ children... }
	</div>
}

// NumberStepperProps — bounded integer input with − / + buttons, fully
// Alpine-driven (`n` is the live value, exposed inside the component's
// x-data scope). Min seeds the initial value; Max=0 means unbounded;
// Step defaults to 1. Pass dynamic disabled / hx-* / extra bindings on
// the inner <input> via Attrs.
type NumberStepperProps struct {
	Name  string
	Label string
	Min   int
	Max   int
	Step  int
	Attrs templ.Attributes
}

// NumberStepper is a compact integer control with glyph buttons at each end.
templ NumberStepper(p NumberStepperProps) {
	{{step := p.Step
if step == 0 {
	step = 1
}
	}}
	<div
		x-data={ "{ n: " + itoa(p.Min) +
				", min: " + itoa(p.Min) +
				", max: " + itoa(p.Max) +
				", step: " + itoa(step) + " }" }
	>
		if p.Label != "" {
			@FieldLabel(p.Label, "")
		}
		<div class="flex">
			<button
				type="button"
				@click="n = Math.max(min, n - step)"
				class="w-10 grid place-items-center clip-lbl bg-accent text-accent-fg font-bold"
				aria-label="Decrease"
			>−</button>
			<input
				type="number"
				id={ p.Name }
				name={ p.Name }
				x-model.number="n"
				:min="min"
				:max="max || undefined"
				:step="step"
				class="cp-field text-center rounded-none"
				{ p.Attrs... }
			/>
			<button
				type="button"
				@click="n = Math.min(max || Number.MAX_SAFE_INTEGER, n + step)"
				class="w-10 grid place-items-center clip-tag bg-primary text-primary-fg font-bold"
				aria-label="Increase"
			>+</button>
		</div>
		{ children... }
	</div>
}
