package ui

// Clock renders a live HH:MM:SS readout with a pulsing status dot.
// Self-contained Alpine island — no Go state required.
templ Clock() {
	<div
		x-data="{ time: '', tick(){ this.time = new Date().toLocaleTimeString('en-GB', {hour12:false}); } }"
		x-init="tick(); setInterval(() => tick(), 1000)"
		class="hidden sm:flex items-center gap-2 px-2 py-1 clip-tag border border-border font-mono text-xs"
		aria-label="Current time"
	>
		<span class="pulse-dot"></span>
		<span class="text-accent" x-text="time">--:--:--</span>
	</div>
}

// ThemeToggle flips the inherited `darkMode` reactive property. HeaderCore
// owns the $watch that persists to localStorage and toggles html.dark.
//
// REQUIRED PARENT SCOPE: an ancestor x-data must expose `darkMode` (bool).
// If you use @HeaderCore (directly or via @Header) this is already true.
templ ThemeToggle() {
	<button
		type="button"
		@click="darkMode = !darkMode"
		:aria-pressed="darkMode.toString()"
		class="px-3 py-1.5 clip-btn border border-accent text-accent font-mono text-xs uppercase tracking-widest glow-btn inline-flex items-center gap-1.5"
		aria-label="Toggle theme"
	>
		<span x-show="darkMode">☀<span class="hidden sm:inline">Day</span></span>
		<span x-show="!darkMode" x-cloak>☾<span class="hidden sm:inline">Night</span></span>
	</button>
}

type DisplayStyle string

const (
	DisplayPrimary DisplayStyle = "primary"
	DisplayAccent  DisplayStyle = "accent"
	DisplayError   DisplayStyle = "error"
	DisplayWarning DisplayStyle = "warning"
	DisplaySuccess DisplayStyle = "success"
	DisplayInfo    DisplayStyle = "info"
	DisplayMuted   DisplayStyle = "muted"
)

// MarqueeItem is one ticker entry. Kind picks the text color.
type MarqueeItem struct {
	Text string
	Kind DisplayStyle // "" | "primary" | "accent" | "error" | "warning" | "success" | "info" | "muted"
}

func marqueeClass(kind string) string {
	switch kind {
	case "primary":
		return "text-primary"
	case "accent":
		return "text-accent"
	case "error":
		return "text-error"
	case "warning":
		return "text-warning"
	case "success":
		return "text-success"
	case "info":
		return "text-info"
	case "muted":
		return "text-muted"
	}
	return "text-accent"
}

// defaultMarqueeItems returns the sensible default ticker line if the caller
// didn't pass any items. Exposed so apps can extend/override it.
func defaultMarqueeItems() []MarqueeItem {
	return []MarqueeItem{
		{"// SYSTEM ONLINE", "error"},
		{"// net.status :: stable", "accent"},
		{"// 0 critical warnings", "primary"},
		{"// press ? for command palette", "muted"},
		{"// mobile-first, accessible, themable", "accent"},
	}
}

// repeatMarquee builds n identical items — handy for single-message tickers
// like error banners where one phrase should tile across the whole line.
func RepeatMarquee(text string, kind DisplayStyle, n int) []MarqueeItem {
	items := make([]MarqueeItem, n)
	for i := range items {
		items[i] = MarqueeItem{Text: text, Kind: kind}
	}

	return items
}

/// Marquee renders an infinitely scrolling ticker moving left (the default).
// Pass no items for the default set.
templ Marquee(items ...MarqueeItem) {
	@MarqueeDir(false, items...)
}

// MarqueeReverse renders the ticker scrolling to the right. Convenience wrapper
// so callers can just write @MarqueeReverse(items...) for a right-moving line.
templ MarqueeReverse(items ...MarqueeItem) {
	@MarqueeDir(true, items...)
}

// MarqueeDir renders an infinitely scrolling ticker in either direction.
// reverse=false scrolls left, reverse=true scrolls right. The two named
// wrappers above are the ergonomic entry points; use this directly when the
// direction is computed at runtime.
templ MarqueeDir(reverse bool, items ...MarqueeItem) {
	{{list := items
if len(list) == 0 {
	list = defaultMarqueeItems()
}
	}}
	<div class="border-b border-border bg-panel/40 overflow-hidden" role="marquee" aria-label="Status ticker">
		<div class={ "marquee-track font-mono text-[11px] py-1.5 uppercase tracking-widest", templ.KV("marquee-track--reverse", reverse) }>
			for i := 0; i < 2; i++ {
				<span class="flex">
					for _, it := range list {
						<span class={ "mx-6", marqueeClass(string(it.Kind)) }>{ it.Text }</span>
					}
				</span>
			}
		</div>
	</div>
}

// MarqueeDisplay is a large, high-impact ticker variant used for full-screen
// states like error pages. It differs from MarqueeDir visually: bigger bold
// text, wide letter-spacing, and a dimmed accent "//" separator between each
// phrase — matching the error-page mockup. reverse=true scrolls right.
//
// Like the other marquees it renders the track twice so the loop is seamless
// at translateX(-50%); the shared .marquee-track / --reverse CSS drives it.
templ MarqueeDisplay(reverse bool, items ...MarqueeItem) {
	<div class="bg-panel/40 overflow-hidden select-none" role="marquee" aria-hidden="true">
		<div class={ "marquee-track py-2.5", templ.KV("marquee-track--reverse", reverse) }>
			for i := 0; i < 2; i++ {
				<span class="flex items-center">
					for _, it := range items {
						<span class={ "font-mono text-sm font-bold uppercase tracking-[0.35em]", marqueeClass(string(it.Kind)) }>{ it.Text }</span>
						<span class="mx-8 text-accent/50 font-mono text-sm font-bold" aria-hidden="true">{ "//" }</span>
					}
				</span>
			}
		</div>
	</div>
}
