package components

import (
	"fmt"
	"strings"
)

type TabItemProps struct {
	ID        string
	Label     string
	Icon      templ.Component
	IsActive  bool
	HasBadge  bool
	HxGet     string
	HxTarget  string
	HxPushURL string
}

templ TabItem(props TabItemProps) {
	<button
		type="button"
		hx-get={ props.HxGet }
		hx-target={ props.HxTarget }
		@click={ "activeTab = '" + props.ID + "'" }
		:class={ "activeTab === '" + props.ID + "' ? 'text-primary' : 'text-primary/40'" }
		class="flex-1 flex flex-col items-center justify-center gap-1 hover:text-primary transition-colors relative"
	>
		<div class="w-6 h-6">
			@props.Icon
		</div>
		if props.HasBadge {
			<div class="absolute top-1 right-1/4 w-2 h-2 bg-error rounded-full"></div>
		}
		<span class="text-xs font-medium">{ props.Label }</span>
	</button>
}

templ TabItemDesktop(props TabItemProps) {
	<button
		type="button"
		hx-get={ props.HxGet }
		hx-target={ props.HxTarget }
		@click={ "activeTab = '" + props.ID + "'" }
		:class={ "activeTab === '" + props.ID + "' ? 'bg-primary/10 text-primary border-primary/20' : 'text-primary/60 border-transparent hover:bg-primary/5'" }
		class="flex items-center gap-3 px-6 py-2.5 rounded-lg border transition-colors relative"
	>
		<div class="w-5 h-5">
			@props.Icon
		</div>
		<span class="font-medium">{ props.Label }</span>
		if props.HasBadge {
			<div class="w-2 h-2 bg-error rounded-full"></div>
		}
	</button>
}

// cyberGenerateTabIndicatorStyle is the cyberpunk-prefixed version of the
// translateX/width helper. Identical math — same ternary chain, same width%.
func cyberGenerateTabIndicatorStyle(tabs []TabConfig) string {
	count := len(tabs)
	if count == 0 {
		return ""
	}

	widthPercent := 100 / count

	var conditions []string
	for i, tab := range tabs {
		translateX := i * 100
		conditions = append(conditions, fmt.Sprintf("activeTab === '%s' ? '%d%%'", tab.ID, translateX))
	}

	translateExpr := strings.Join(conditions, " : ") + " : '0%'"

	return fmt.Sprintf("'transform: translateX(' + (%s) + '); width: %d%%'", translateExpr, widthPercent)
}

// CyberTabItem is the mobile bottom-bar tab. Cyberpunk treatment:
//   - mono uppercase tracking-widest label
//   - clip-tag corners on the active state with a subtle bg-primary/10 wash
//   - error-coloured glowing badge dot
//   - icon nudges up 1px on active for tactile feel
//
// Functionality is unchanged: same hx-get / hx-target / hx-push-url, same
// Alpine activeTab assignment, same :class active branch.
templ CyberTabItem(props TabItemProps) {
	<button
		type="button"
		hx-get={ props.HxGet }
		hx-target={ props.HxTarget }
		@click={ "activeTab = '" + props.ID + "'" }
		:class={ "activeTab === '" + props.ID + "' ? 'text-primary bg-primary/10 clip-tag' : 'text-accent/60 hover:text-accent'" }
		class="flex-1 flex flex-col items-center justify-center gap-1 transition-colors relative font-mono text-[10px] uppercase tracking-widest"
		:aria-current={ "activeTab === '" + props.ID + "' ? 'page' : null" }
	>
		<div
			class="w-6 h-6 transition-transform"
			:class={ "activeTab === '" + props.ID + "' ? '-translate-y-0.5' : ''" }
		>
			@props.Icon
		</div>
		if props.HasBadge {
			<div class="absolute top-1 right-1/4 w-2 h-2 bg-error rounded-full shadow-[0_0_6px_var(--color-error)]" aria-label="New"></div>
		}
		<span>{ props.Label }</span>
	</button>
}

// CyberTabItemDesktop is the desktop horizontal-bar tab. Cyberpunk treatment:
//   - clip-tag corners (replacing rounded-lg)
//   - active state uses bg-primary text-primary-fg font-bold (the same "tag"
//     pattern used by HeaderNav active links)
//   - inactive state uses text-accent with bg-accent/10 hover wash
//   - mono uppercase tracking-widest typography for the label
//
// Functionality unchanged.
templ CyberTabItemDesktop(props TabItemProps) {
	<button
		type="button"
		hx-get={ props.HxGet }
		hx-target={ props.HxTarget }
		@click={ "activeTab = '" + props.ID + "'" }
		:class={ "activeTab === '" + props.ID + "' ? 'bg-primary text-primary-fg font-bold' : 'text-accent hover:bg-accent/10'" }
		class="flex items-center gap-2 px-4 py-2 clip-tag transition-colors relative font-mono text-xs uppercase tracking-widest"
		:aria-current={ "activeTab === '" + props.ID + "' ? 'page' : null" }
	>
		<div class="w-4 h-4">
			@props.Icon
		</div>
		<span>{ props.Label }</span>
		if props.HasBadge {
			<div class="w-2 h-2 bg-error rounded-full shadow-[0_0_6px_var(--color-error)]" aria-label="New"></div>
		}
	</button>
}
