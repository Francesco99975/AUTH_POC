package components

import (
	"github.com/Francesco99975/authpoc/views/icons"
	"github.com/Francesco99975/authpoc/views/ui"

	"github.com/Francesco99975/authpoc/internal/auth"
	"github.com/Francesco99975/authpoc/internal/enums"
	"strconv"
)

type UsersProps struct {
	Users      []UserInfo
	TotalUsers int
	Page       int
	PerPage    int
	Viewer     enums.Role
	CSRF       string
}

type UserInfo struct {
	ID        string
	Username  string
	Email     string
	Initials  string
	Role      string
	Status    string
	TwoFA     bool
	LastLogin string
	Gradient  string
	CanEdit   bool
	CanDelete bool
}

func allowedCreateRoles(viewer enums.Role) []ui.DropOption {
	all := []enums.Role{enums.Roles.USER, enums.Roles.ADMIN, enums.Roles.DEVELOPER}
	out := []ui.DropOption{}
	for _, r := range all {
		if auth.CanManageUser(viewer, enums.ActCreate, r) {
			out = append(out, ui.DropOption{Value: r.String(), Label: r.String()})
		}
	}
	return out
}

templ SettingsUsersTab(props UsersProps) {
	<div x-show="activeTab === 'users'" x-cloak x-transition:enter="transition ease-out duration-200" x-transition:enter-start="opacity-0 translate-y-2" x-transition:enter-end="opacity-100 translate-y-0" class="space-y-4">
		@UserManagementCard(props)
	</div>
}

templ UserManagementCard(props UsersProps) {
	<div class="rounded-xl border border-primary/10 bg-std shadow-sm" x-data="{ showCreateForm: false }">
		<div class="border-b border-primary/10 px-4 sm:px-6 py-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
			<div>
				<h2 class="text-base sm:text-lg font-semibold text-primary">User Management</h2>
				<p class="text-sm text-primary/60">Create and manage users</p>
			</div>
			@ui.Button(ui.ButtonProps{
				Variant: ui.ButtonPrimary,
				Size:    ui.ButtonLG,
				Attrs:   templ.Attributes{"@click": "showCreateForm = !showCreateForm"},
			}) {
				@icons.PlusIcon("w-4 h-4")
				<span>Create User</span>
			}
		</div>
		<!-- Create User Form -->
		@CreateUserForm(props.CSRF, props.Viewer)
		<!-- Filters -->
		@UserFilters(props.Viewer)
		<!-- Users List -->
		<div class="divide-y divide-primary/10" id="users-list">
			@UserList(props.Users, props.CSRF)
		</div>
		<!-- Pagination -->
		@UsersPagination(props.TotalUsers, props.Page, props.PerPage, false)
	</div>
}

templ UserList(users []UserInfo, csrf string) {
	for _, user := range users {
		@SettingsUserItem(user, csrf)
	}
}

templ CreateUserForm(csrf string, viewer enums.Role) {
	<div x-show="showCreateForm" x-collapse class="border-b border-primary/10 bg-primary/5">
		<form
			hx-post="/settings/users/create"
			hx-target="#users-list"
			hx-swap="afterbegin"
			{ ui.WithLoading("create-user-indicator")... }
			@htmx:after-request="if(event.detail.successful) showCreateForm = false"
			class="p-4 sm:p-6 space-y-4"
		>
			@CSRF(csrf)
			<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
				@ui.Input(ui.InputProps{
					Name:     "username",
					Label:    "Username",
					Required: true,
				})
				@ui.Input(ui.InputProps{
					Name:     "email",
					Type:     "email",
					Label:    "Email",
					Required: true,
				})
				@ui.SecurePasswordInput(ui.PasswordProps{
					Name:          "password",
					Label:         "Password",
					Required:      true,
					ShowStrength:  true,
					MinLen:        8,
					RequireNumber: true,
					RequireCaps:   true,
					RequireSymbol: true,
				})
				@ui.Droplist(ui.DroplistProps{
					Name: "role", Label: "Role",
					Required: true,
					Selected: enums.Roles.USER.String(),
					Opts:     allowedCreateRoles(viewer),
				})
			</div>
			<div class="flex flex-col-reverse sm:flex-row justify-end gap-3 pt-4">
				@ui.Button(ui.ButtonProps{
					Variant: ui.ButtonGhost,
					Size:    ui.ButtonMD,
					Attrs:   templ.Attributes{"@click": "showCreateForm = false"},
				}) {
					<span>
						Cancel
					</span>
				}
				@ui.Button(ui.ButtonProps{
					Variant: ui.ButtonPrimary,
					Size:    ui.ButtonMD,
					Type:    ui.TypeSubmit,
					Loading: ui.LoadingConfig{
						IndicatorID: "create-user-indicator",
					},
				}) {
					<span>
						Create User
					</span>
				}
			</div>
		</form>
	</div>
}

templ UserFilters(viewer enums.Role) {
	<div class="px-4 sm:px-6 py-4 border-b border-primary/10 flex flex-col sm:flex-row gap-3">
		<div class="flex-1">
			@ui.Search(ui.SearchProps{
				Name:           "search",
				GetURL:         "/search/users",
				TargetID:       "users-list",
				DebounceMS:     300,
				Label:          "Search Users",
				Placeholder:    "Search users...",
				ExternalTarget: true,
				Include:        "[name='role_filter']",
			})
		</div>
		@ui.FilterSelect(ui.FilterSelectProps{
			Name:    "role_filter",
			Label:   "Filter Role",
			Opts:    allowedCreateRoles(viewer),
			URL:     "/search/users",
			Trigger: "change",
			Target:  "users-list",
			Swap:    "innerHTML",
			Include: "[name='search']",
		})
	</div>
}

templ SettingsUserItem(user UserInfo, csrf string) {
	<div class="p-4 hover:bg-primary/5 transition-colors">
		<div class="flex items-start justify-between gap-3">
			<div class="flex items-center gap-3 min-w-0">
				<div class={ "shrink-0 h-10 w-10 rounded-full flex items-center justify-center", user.Gradient }>
					<span class="font-bold text-accent uppercase">{ user.Initials }</span>
				</div>
				<div class="min-w-0">
					<p class="text-sm font-medium text-primary truncate">{ user.Username }</p>
					<p class="text-xs text-primary/60 truncate">{ user.Email }</p>
				</div>
			</div>
			<div class="flex items-center gap-2">
				if user.Status == "Inactive" {
					<form
						hx-post="/settings/users/reactivate"
						hx-target="closest div.p-4"
						hx-swap="outerHTML"
					>
						@CSRF(csrf)
						@ui.HiddenInput("user_id", user.ID)
						@ui.IconButton(ui.ButtonProps{
							Variant: ui.ButtonGhost,
							Size:    ui.ButtonSM,
							Type:    "sumbit",
						}) {
							@icons.Refresh("w-4 h-4")
						}
					</form>
				}
				if user.CanEdit {
					<form hx-get={ "/settings/users/" + user.ID + "/edit" } { ui.WithLoading("edit-user-indicator")... }>
						@ui.IconButton(ui.ButtonProps{
							Variant: ui.ButtonGhost,
							Size:    ui.ButtonSM,
							Type:    "submit",
							Loading: ui.LoadingConfig{
								IndicatorID: "edit-user-indicator",
							},
						}) {
							@icons.Edit("w-4 h-4")
						}
					</form>
				}
				if user.CanDelete {
					<form
						hx-post="/settings/users/delete"
						hx-target="closest div.p-4"
						hx-swap="outerHTML"
						{ ui.WithLoading("delete-user-indicator")... }
						hx-confirm="Are you sure you want to delete this user?"
					>
						@CSRF(csrf)
						@ui.HiddenInput("user_id", user.ID)
						@ui.IconButton(ui.ButtonProps{
							Variant: ui.ButtonGhostDanger,
							Size:    ui.ButtonSM,
							Type:    "submit",
							Loading: ui.LoadingConfig{
								IndicatorID: "delete-user-indicator",
							},
						}) {
							@icons.Trash("w-4 h-4")
						}
					</form>
				}
			</div>
		</div>
		<div class="mt-3 flex flex-wrap items-center gap-2">
			@RoleBadge(user.Role)
			@StatusBadge(user.Status)
			if user.TwoFA {
				<span class="inline-flex items-center gap-1 text-xs text-success">
					@icons.Shield("w-3.5 h-3.5")
					2FA
				</span>
			}
			<span class="text-xs text-primary/50 ml-auto">{ user.LastLogin }</span>
		</div>
	</div>
}

templ StatusBadge(status string) {
	if status == "Active" {
		<span class="inline-flex items-center rounded-full bg-success/10 px-2 py-0.5 text-xs font-medium text-success">{ status }</span>
	} else {
		<span class="inline-flex items-center rounded-full bg-error/10 px-2 py-0.5 text-xs font-medium text-error">{ status }</span>
	}
}

templ UsersPagination(total int, page int, perPage int, oob bool) {
	<div
		id="users-pagination"
		if oob {
			hx-swap-oob="true"
		}
		class="px-4 sm:px-6 py-4 border-t border-primary/10 flex flex-col sm:flex-row items-center justify-between gap-3"
	>
		<p class="text-sm text-primary/60">
			Showing <span class="font-medium text-primary">{ strconv.Itoa((page-1)*perPage + 1) }-{ strconv.Itoa(min(page*perPage, total)) }</span> of <span class="font-medium text-primary">{ strconv.Itoa(total) }</span>
		</p>
		<div class="flex items-center gap-1">
			@ui.Pagination(ui.PaginationProps{
				Current:    page,
				TotalRows:  total,
				TotalPages: (total + perPage - 1) / perPage,
				Window:     perPage,
				URL:        "/search/users",
				Target:     "users-list",
				Swap:       "innerHTML",
				Include:    "[name='search'], [name='role_filter']",
				PushURL:    false,
			})
		</div>
	</div>
}

func min(a, b int) int {
	if a < b {
		return a
	}
	return b
}
