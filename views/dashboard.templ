package views

import (
	"fmt"
	"time"

	"github.com/Francesco99975/authpoc/internal/models"
	"math"

	"github.com/Francesco99975/authpoc/views/layouts"
	"github.com/Francesco99975/authpoc/views/ui"
	"strings"
)

type DashboardProps struct {
	Username     string
	Email        string
	GithubStatus *models.GithubStatusResponse
	Coins        []models.CryptoCoin
	Cities       []models.CityWeather
	Quakes       []models.GeoFeature
}

templ Dashboard(site models.Site, props DashboardProps) {
	@layouts.AdminLayout(site) {
		<main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 min-h-screen">
			<!-- Welcome Section -->
			<div class="mb-8">
				<h1 class="text-3xl sm:text-4xl font-bold bg-linear-to-r from-primary to-accent bg-clip-text text-transparent mb-2">
					Welcome back, { props.Username }!
				</h1>
				<p class="text-gray-600 dark:text-gray-400">
					{ props.Email }
				</p>
			</div>
			<section class="container mx-auto px-4 pt-8 pb-6">
				<div class="flex items-end gap-4 flex-wrap">
					<div>
						<div class="font-mono text-[10px] text-accent uppercase tracking-widest">\\ telemetry node 06</div>
						<h1 class="text-3xl sm:text-4xl font-bold neon-primary caret">API_COMPONENTS_DASHBOARD</h1>
					</div>
					<p class="font-mono text-xs text-muted max-w-md">
						Real public APIs feed every component below — GitHub Status, CoinGecko, Open-Meteo, USGS Seismic.
					</p>
				</div>
			</section>
			<div class="container mx-auto px-4 pb-20 grid grid-cols-1 lg:grid-cols-2 gap-6">
				@layouts.Poller("github-indicator", "Loading GitHub status...", "/external/github", time.Second*60) {
					@GithubStatus(props.GithubStatus)
				}
				@layouts.Poller("coins-indicator", "Loading Crypto Prices...", "/external/coins", time.Second*60) {
					@CryptoCoinsDisplay(props.Coins)
				}
				@layouts.Poller("weather-indicator", "Loading Cities Weather...", "/external/weather", time.Second*60) {
					@CitiesWeatherDisplay(props.Cities)
				}
				@layouts.Poller("quakes-indicator", "Loading Quakes Reports...", "/external/quakes", time.Second*60) {
					@QuakesDisplay(props.Quakes)
				}
			</div>
		</main>
	}
}

templ GithubStatus(githubStatus *models.GithubStatusResponse) {
	<!-- ╔══════════════ SYSTEM HEALTH (GitHub Status) ══════════════╗ -->
	@layouts.DashSection("GITHUB_STATUS", "// stream 01", "live") {
		<!-- Data -->
		if githubStatus != nil {
			<div
				class="space-y-4"
			>
				<!-- Overall status alert -->
				if githubStatus.Status.Indicator != "none" {
					switch githubStatus.Status.Indicator {
						case "critical":
							@ui.Alert(ui.AlertError, fmt.Sprintf("INCIDENT // %s", strings.ToUpper(githubStatus.Status.Indicator))) {
								{ githubStatus.Status.Description }
							}
						case "major":
							@ui.Alert(ui.AlertWarning, fmt.Sprintf("INCIDENT // %s", strings.ToUpper(githubStatus.Status.Indicator))) {
								{ githubStatus.Status.Description }
							}
						default:
							@ui.Alert(ui.AlertInfo, fmt.Sprintf("INCIDENT // %s", strings.ToUpper(githubStatus.Status.Indicator))) {
								{ githubStatus.Status.Description }
							}
					}
				} else {
					@ui.Alert(ui.AlertSuccess, "ALL SYSTEMS NOMINAL") {
						{ githubStatus.Status.Description }
					}
				}
				<!-- Component status dots -->
				<ul class="grid grid-cols-1 sm:grid-cols-2 gap-2">
					for _, component := range githubStatus.Components {
						@githubComponentDisplay(component)
					}
				</ul>
			</div>
		} else {
			@ui.EmptyState(ui.EmptyStateProps{
				Title:       "Github Unreachable",
				Description: "// check your internet connection",
				CTALabel:    "REFRESH",
				CTAHref:     "/dashboard",
			})
		}
	}
}

templ githubComponentDisplay(component models.GithubComponent) {
	<li class="flex items-center justify-between gap-2 px-3 py-2 bg-panel/60 border-l-2 border-accent/40">
		<span class="flex items-center gap-2 font-mono text-[11px]">
			<span
				class={ "pulse-dot shadow-2xs", models.DotKind(component.Status) }
			></span>
			<span class="truncate">{ component.Name }</span>
		</span>
		<span
			class={ "clip-tag font-mono text-[9px] uppercase px-2 py-0.5", models.BadgeClass(component.Status) }
		>{ component.Status }</span>
	</li>
}

templ CryptoCoinsDisplay(coins []models.CryptoCoin) {
	<!-- ╔══════════════ MARKETS (CoinGecko) ══════════════╗ -->
	@layouts.DashSection("CRYPTO_MARKETS", "// stream 02", "USD") {
		<!-- Data -->
		if len(coins) > 0 {
			<ul class="space-y-3">
				for _, coin := range coins {
					@coinData(coin)
				}
			</ul>
		} else {
			@ui.EmptyState(ui.EmptyStateProps{
				Title:       "Coin Gecko Unreachable",
				Description: "// check your internet connection",
				CTALabel:    "REFRESH",
				CTAHref:     "/dashboard",
			})
		}
	}
}

templ coinData(coin models.CryptoCoin) {
	<li class="bg-panel/60 clip-tag p-3">
		<div class="flex items-center gap-3 mb-2">
			<img src={ coin.Image } alt={ coin.Name } class="w-8 h-8 flex-none" loading="lazy"/>
			<div class="flex-1 min-w-0">
				<div class="flex items-center gap-2">
					<span class="font-bold truncate">{ coin.Name }</span>
					<span class="clip-tag font-mono text-[9px] uppercase px-2 py-0.5 border border-muted text-muted">{ coin.Symbol }</span>
				</div>
				<div class="font-mono text-xs text-muted">{ coin.CurrentPrice }</div>
			</div>
			<span
				class={ "clip-tag font-mono text-[10px] uppercase px-2 py-0.5", priceChangeClass(coin.PriceChangePercentage24h) }
			>{ priceChangeText(coin.PriceChangePercentage24h) }</span>
		</div>
		<!-- 24h change as bar (abs, 0..10% mapped to 0..100) -->
		@ui.ProgressBar(ui.ProgressBarProps{
			Label:         "24H_CHANGE",
			Value:         int(math.Min(100, math.Round(math.Abs(coin.PriceChangePercentage24h)*10))),
			Indeterminate: false,
			ShowValue:     true,
		})
	</li>
}

func priceChangeClass(v float64) string {
	if v >= 0 {
		return "bg-success text-std"
	}
	return "bg-error text-std"
}

func priceChangeText(v float64) string {
	arrow := "▲ "
	if v < 0 {
		arrow = "▼ "
	}
	return fmt.Sprintf("%s%.2f%%", arrow, math.Abs(v))
}

func priceBarClass(v float64) string {
	if v >= 0 {
		return "is-success"
	}
	return "is-error"
}

func priceBarWidth(v float64) string {
	width := math.Min(100, math.Abs(v)*10)
	return fmt.Sprintf("width: %.2f%%", width)
}

templ CitiesWeatherDisplay(cities []models.CityWeather) {
	<!-- ╔══════════════ TELEMETRY (Open-Meteo) ══════════════╗ -->
	@layouts.DashSection("ATMOSPHERIC_TELEMETRY", "// stream 03", "6 nodes") {
		<!-- Data -->
		if len(cities) > 0 {
			<div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
				for _, city := range cities {
					@cityWeather(city)
				}
			</div>
		} else {
			@ui.EmptyState(ui.EmptyStateProps{
				Title:       "Open Weather Unreachable",
				Description: "// check your internet connection",
				CTALabel:    "REFRESH",
				CTAHref:     "/dashboard",
			})
		}
	}
}

templ cityWeather(city models.CityWeather) {
	<div class="bg-panel/60 clip-tag p-3">
		<div class="flex items-center justify-between mb-2">
			<div>
				<div class="font-mono text-[10px] text-accent uppercase tracking-widest">{ city.CityName }</div>
				<div class="text-2xl font-bold neon-primary">{ city.Weather.Current.Temperature2M } °C</div>
			</div>
			<!-- Cloud-cover ring (0..100) -->
			@ui.ProgressRing(ui.ProgressRingProps{
				Value: city.Weather.Current.CloudCover,
				Label: "CLOUD COVER",
			})
		</div>
		<!-- Humidity bar -->
		@ui.ProgressBar(ui.ProgressBarProps{
			Label:         "HUMIDITY",
			Value:         city.Weather.Current.RelativeHumidity2M,
			Indeterminate: false,
			ShowValue:     true,
		})
		<!-- Wind bar (0..30 m/s mapped) -->
		@ui.ProgressBar(ui.ProgressBarProps{
			Label:         "WIND",
			Value:         int(math.Min(100, math.Round(city.Weather.Current.WindSpeed10M*10))),
			Indeterminate: false,
			ShowValue:     true,
		})
	</div>
}

templ QuakesDisplay(quakes []models.GeoFeature) {
	<!-- ╔══════════════ SEISMIC (USGS earthquakes) ══════════════╗ -->
	@layouts.DashSection("SEISMIC_FEED", "// stream 04", "PAST_HOUR") {
		<!-- Data -->
		if len(quakes) > 0 {
			<ul class="space-y-2 max-h-[420px] overflow-y-auto">
				for _, quake := range quakes {
					@quakeDisplay(quake)
				}
			</ul>
		} else {
			@ui.EmptyState(ui.EmptyStateProps{
				Title:       "Open Weather Unreachable",
				Description: "// check your internet connection",
				CTALabel:    "REFRESH",
				CTAHref:     "/dashboard",
			})
		}
	}
}

templ quakeDisplay(quake models.GeoFeature) {
	<li class="bg-panel/60 clip-tag p-3 flex items-center gap-3">
		<div class="flex-none w-14 text-center">
			<div
				class={ "font-bold text-2xl", magClass(*quake.Properties.Mag) }
			>{ fmt.Sprintf("%.1f", *quake.Properties.Mag) }</div>
			<div class="font-mono text-[9px] text-muted uppercase">MAG</div>
		</div>
		<div class="flex-1 min-w-0">
			<div class="text-sm truncate">{ quake.Properties.Place }</div>
			<div class="font-mono text-[10px] text-muted">{ models.TimeAgo(quake.Properties.Time) }</div>
			<!-- Severity rating: 1..5 stars from magnitude -->
			@ui.Rating(ui.RatingProps{
				Name:     "severity",
				Value:    models.MagToStars(*quake.Properties.Mag),
				Max:      5,
				Disabled: true,
			})
		</div>
		<span
			class={ "clip-tag font-mono text-[9px] uppercase px-2 py-0.5 " + severityBadgeClass(*quake.Properties.Mag) }
		>{ severityText(*quake.Properties.Mag) }</span>
	</li>
}

func magClass(m float64) string {
	if m >= 5 {
		return "text-error"
	}
	if m >= 3 {
		return "text-warning"
	}
	return "text-primary"
}

func starClass(i int, m float64) string {
	if i <= models.MagToStars(m) {
		return "text-primary"
	}
	return "text-muted/40"
}

func severityText(m float64) string {
	if m >= 5 {
		return "critical"
	}
	if m >= 3 {
		return "moderate"
	}
	return "minor"
}

func severityBadgeClass(m float64) string {
	if m >= 5 {
		return "bg-error text-std"
	}
	if m >= 3 {
		return "bg-warning text-std"
	}
	return "border border-muted text-muted"
}
